# ---- web app (apps/web)
PORT=3000
# Set automatically by deploy/start.sh. Set it yourself only when the engine runs elsewhere.
# FINN_ENGINE_URL=http://127.0.0.1:8787
# Shared secret between web app and engine. Strongly recommended if the engine is reachable from anywhere but localhost.
FINN_ENGINE_TOKEN=
# Optional overrides of where the web app reads data (defaults: apps/web/data/feed.json and apps/web/data/research/)
# FINN_FEED_PATH=
# FINN_RESEARCH_DIR=

# ---- engine (engine/)
# 1 = don't fetch NSE/BSE for tickers outside the fixtures (on-demand research then only serves the demo companies)
FINN_NO_LIVE=0
# Optional model wording (push explanations and Ask FINN). Both must be set; output is still checked against the evidence.
GEMINI_API_KEY=
FINN_EXPLAIN_MODEL=
# 1 = regenerate the synthetic fixture data on start
FINN_REBUILD_FIXTURES=0
